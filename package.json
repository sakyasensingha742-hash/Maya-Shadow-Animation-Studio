{
  "name": "maya-shadow-animation-studio",
  "productName": "Maya Shadow Animation Studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:desktop": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "electron-updater": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "ffmpeg-static": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.mayashadow.animationstudio",
    "productName": "Maya Shadow Animation Studio",
    "asar": true,
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/ffmpeg-static/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Maya-Shadow-Animation-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "sakyasensingha742-hash",
      "repo": "Maya-Shadow-Animation-Studio",
      "releaseType": "release"
    }
  }
}
